APP_NAME=eSawda
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_TIMEZONE=UTC
APP_URL=http://localhost:8100

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file

PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# API serves the Next.js frontend. DB_CONNECTION is sqlite for
# zero-friction dev; use MySQL for the real legacy `ad_` database (README).
DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=quickad
# DB_USERNAME=root
# DB_PASSWORD=
# DB_PREFIX=ad_

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
# sync sends mail/fulfilment inline (dev); database defers to a queue worker.
QUEUE_CONNECTION=sync

# Caching backend for the read-heavy endpoints (category tree, site settings,
# featured/similar ads, countries, filter-schema, seller stats, admin
# dashboard). Use `redis` on any non-dev host for in-memory speed; `file` and
# `database` work but hit disk (slower + higher I/O under load).
CACHE_STORE=redis
CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@esawda.com"
MAIL_FROM_NAME="${APP_NAME}"

# --------------------------------------------------------------------------
# CORS + frontend origins. Comma-separated list of allowed frontend origins
# (used by config/cors.php and the password-reset link builder).
# --------------------------------------------------------------------------
FRONTEND_URLS=http://localhost:3000
FRONTEND_URL=http://localhost:3000
FRONTEND_REVALIDATE_SECRET=change-me

# --------------------------------------------------------------------------
# SSLCommerz payment gateway (sole active gateway).
# Credentials come ONLY from real env — no defaults are shipped; the gateway
# refuses to initiate when unset.
# --------------------------------------------------------------------------
SSLCOMMERZ_MODE=sandbox
SSLCOMMERZ_STORE_ID=
SSLCOMMERZ_STORE_PASSWORD=
SSLCOMMERZ_CURRENCY=BDT
SSLCOMMERZ_LOCALHOST=true
SSLCOMMERZ_VERIFY_HASH=true

# --------------------------------------------------------------------------
# Sanctum token lifetime (minutes). Default 1440 = 24h.
# --------------------------------------------------------------------------
SANCTUM_TOKEN_EXPIRATION=1440
