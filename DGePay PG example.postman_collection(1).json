      "name": "Authenticate Copy",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "// Parse response body",
              "let response = pm.response.json();",
              "",
              "// Check if status code is 200 and access_token exists",
              "if (pm.response.code === 200 && response.data && response.data.access_token) {",
              "    // Save access_token to environment variable",
              "    pm.environment.set(\"access_token\", \"Bearer \" + response.data.access_token);",
              "",
              "    // Optionally store the expiry_time as well",
              "    if (response.data.expiry_time) {",
              "        pm.environment.set(\"token_expiry_time\", response.data.expiry_time);",
              "    }",
              "",
              "    console.log(\"Access token and expiry time saved to environment.\");",
              "} else {",
              "    console.warn(\"Access token not found or request failed.\");",
              "}",
              ""
            ],
            "type": "text/javascript",
            "packages": {},
            "requests": {}
          }
        }
      ],
      "request": {
        "auth": {
          "type": "basic",
          "basic": [
            {
              "key": "password",
              "value": "a487e7adeb7d6af7",
              "type": "string"
            },
            {
              "key": "username",
              "value": "e138a51e5bdd412dbd303a56be11ecab",
