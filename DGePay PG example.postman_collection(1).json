    {
      "name": "InitiatePayment Copy",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              ""
            ],
            "type": "text/javascript",
            "packages": {},
            "requests": {}
          }
        },
        {
          "listen": "prerequest",
          "script": {
            "exec": [
              "// Postman Pre-request Script for Signature Generation",
              "// Uses environment variables for API_KEY and SECRET_KEY",
              "// Handles amount formatting to match server behavior",
              "",
              "// Get API key and secret key from environment variables",
              "const API_KEY = \"6a04cdb22975427993bad1e1cd4a5ac4\";",
              "const SECRET_KEY = \"a487e7adeb7d6af7\";",
              "",
              "// Get the request body (assuming it's in the \"Body\" tab)",
              "const requestBody = pm.request.body.raw;",
              "",
              "// Parse the JSON payload",
              "let payload;",
              "try {",
              "    payload = JSON.parse(requestBody);",
              "    console.log(\"request payload : \",payload);",
              "} catch (e) {",
              "    console.error(\"Error parsing request body:\", e);",
              "    return;",
              "}",
              "",
              "// Function to normalize amount values to match server behavior",
              "function normalizeAmount(value) {",
              "    if (typeof value === 'number') {",
              "        // Convert integers to decimal format (e.g., 15 -> 15.0)",
              "        if (Number.isInteger(value)) {",
              "            return value + '.0';",
              "        }",
              "        // For decimals, return as string to preserve exact format",
              "        return value.toString();",
              "    }",
              "    return value;",
              "}",
              "",
              "// Function to create checksum string (same logic as Java)",
              "function createCheckSum(payload) {",
              "    function buildChecksumString(obj, checksumBuilder) {",
              "        // Sort keys alphabetically",
              "        const sortedKeys = Object.keys(obj).sort();",
              "        ",
              "        for (const key of sortedKeys) {",
              "            const value = obj[key];",
              "            checksumBuilder.push(key);",
              "            ",
              "            if (value === null) {",
              "                checksumBuilder.push(\"null\");",
              "            } else if (typeof value === 'object' && !Array.isArray(value)) {",
              "                // Handle nested objects",
              "                buildChecksumString(value, checksumBuilder);",
              "            } else {",
              "                // Handle primitive values and strings - remove spaces and colons",
              "                let stringValue;",
              "                if (key === 'amount') {",
              "                    // Special handling for amount field",
              "                    stringValue = normalizeAmount(value);",
              "                } else {",
              "                    stringValue = String(value);",
              "                }",
              "                // Remove spaces and colons from all string values",
              "                stringValue = stringValue.replace(/\\s+/g, '').replace(/:/g, '');",
              "                checksumBuilder.push(stringValue);",
              "            }",
              "        }",
              "    }",
              "    ",
              "    const checksumParts = [];",
              "    buildChecksumString(payload, checksumParts);",
              "    return checksumParts.join('');",
              "}",
              "",
              "// Function to generate HMAC-SHA256 signature",
              "function generateHMACSignature(apiKey, body) {",
              "    // Use CryptoJS for HMAC-SHA256",
              "    const hash = CryptoJS.HmacSHA256(body, apiKey);",
              "    return CryptoJS.enc.Base64.stringify(hash);",
              "}",
              "",
              "// Function to encrypt payload using AES",
              "function encryptPayload(body, secretKey) {",
              "    // Ensure key is exactly 16 bytes (128 bits)",
              "    const keyBytes = CryptoJS.enc.Utf8.parse(secretKey);",
              "    const key16 = CryptoJS.enc.Utf8.parse(secretKey.substring(0, 16));",
              "    ",
              "    // Encrypt using AES-ECB",
              "    const encrypted = CryptoJS.AES.encrypt(body, key16, {",
              "        mode: CryptoJS.mode.ECB,",
              "        padding: CryptoJS.pad.Pkcs7",
              "    });",
              "    ",
              "    return encrypted.toString();",
              "}",
              "",
              "// Generate checksum string",
              "const checksumString = createCheckSum(payload);",
              "console.log(\"Checksum String:\", checksumString);",
              "",
              "// Generate signature",
              "const signature = generateHMACSignature(API_KEY, checksumString);",
              "console.log(\"Generated Signature:\", signature);",
              "",
              "// Encrypt payload",
              "const encryptedPayload = encryptPayload(requestBody, SECRET_KEY);",
              "console.log(\"Encrypted Payload:\", encryptedPayload);",
              "",
              "// Set the signature in the request header",
              "pm.request.headers.add({",
              "    key: 'Signature',",
              "    value: signature",
              "});",
              "",
              "// Set the encrypted payload as the request body",
              "pm.request.body.update(encryptedPayload, false);",
              "",
              "// Also set Content-Type to text/plain",
              "pm.request.headers.add({",
              "    key: 'Content-Type',",
              "    value: 'text/plain'",
              "});",
              "",
              "// Log for debugging",
              "console.log(\"API Key used:\", API_KEY);",
              "console.log(\"Secret Key used:\", SECRET_KEY);",
              "console.log(\"Request updated with signature:\", signature);",
              "console.log(\"Request body updated with encrypted payload\");"
            ],
            "type": "text/javascript",
            "packages": {},
            "requests": {}
          }
        }
      ],
